ne;top=0;left=0;bottom=0;right=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;" parent="just_t2_r3" vertex="1"><mxGeometry x="444" width="1036" height="30" as="geometry"><mxRectangle width="1036" height="30" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="just_t2_r4" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="just_t2" vertex="1"><mxGeometry y="136" width="1480" height="30" as="geometry" /></mxCell><mxCell id="just_t2_r4_c0" value="3e forme normale" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#f5f5f5;top=0;left=0;bottom=0;right=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontStyle=1;" parent="just_t2_r4" vertex="1"><mxGeometry x="0" width="444" height="30" as="geometry"><mxRectangle width="444" height="30" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="just_t2_r4_c1" value="Chaque table a une clé simple ; chaque colonne dépend de toute la clé et seulement d'elle (aucune dépendance entre colonnes non-clés)." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;" parent="just_t2_r4" vertex="1"><mxGeometry x="444" width="1036" height="30" as="geometry"><mxRectangle width="1036" height="30" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="just_t3_titre" value="Objections probables" style="text;html=1;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40.0" y="2453" width="900" height="30" as="geometry" /></mxCell><mxCell id="just_t3" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=1;columnLines=1;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="40.0" y="2488" width="1480" height="212" as="geometry" /></mxCell><mxCell id="just_t3_r0" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="just_t3" vertex="1"><mxGeometry y="0" width="1480" height="30" as="geometry" /></mxCell><mxCell id="just_t3_r0_c0" value="Question du jury" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontStyle=1;" parent="just_t3_r0" vertex="1"><mxGeometry x="0" width="444" height="30" as="geometry"><mxRectangle width="444" height="30" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="just_t3_r0_c1" value="Réponse" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontStyle=1;" parent="just_t3_r0" vertex="1"><mxGeometry x="444" width="1036" height="30" as="geometry"><mxRectangle width="1036" height="30" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="just_t3_r1" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="just_t3" vertex="1"><mxGeometry y="30" width="1480" height="46" as="geometry" /></mxCell><mxCell id="just_t3_r1_c0" value="« &lt;font face='Consolas' color='#1f4e79'&gt;cout_eur&lt;/font&gt; et &lt;font face='Consolas' color='#1f4e79'&gt;montant_eur&lt;/font&gt;, c'est redondant ? »" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#f5f5f5;top=0;left=0;bottom=0;right=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontStyle=1;" parent="just_t3_r1" vertex="1"><mxGeometry x="0" width="444" height="46" as="geometry"><mxRectangle width="444" height="46" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="just_t3_r1_c1" value="Non : &lt;font face='Consolas' color='#1f4e79'&gt;cout_eur&lt;/font&gt; est le prix de la recharge, &lt;font face='Consolas' color='#1f4e79'&gt;montant_eur&lt;/font&gt; un fait de paiement avec son propre statut. Égaux dans les données (0 écart), mais seul un paiement &lt;font face='Consolas' color='#1f4e79'&gt;accepte&lt;/font&gt; compte dans le chiffre d'affaires." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;" parent="just_t3_r1" vertex="1"><mxGeometry x="444" width="1036" height="46" as="geometry"><mxRectangle width="1036" height="46" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="just_t3_r2" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="just_t3" vertex="1"><mxGeometry y="76" width="1480" height="30" as="geometry" /></mxCell><mxCell id="just_t3_r2_c0" value="« Quelles sessions sont payées ? »" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#f5f5f5;top=0;left=0;bottom=0;right=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontStyle=1;" parent="just_t3_r2" vertex="1"><mxGeometry x="0" width="444" height="30" as="geometry"><mxRectangle width="444" height="30" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="just_t3_r2_c1" value="Uniquement les terminées : 217 300 sessions terminées, 217 300 paiements, 1 par session. Les 20 241 interrompues ont un coût mais aucun paiement." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;" parent="just_t3_r2" vertex="1"><mxGeometry x="444" width="1036" height="30" as="geometry"><mxRectangle width="1036" height="30" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="just_t3_r3" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="just_t3" vertex="1"><mxGeometry y="106" width="1480" height="30" as="geometry" /></mxCell><mxCell id="just_t3_r3_c0" value="« Le chiffre d'affaires ? »" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#f5f5f5;top=0;left=0;bottom=0;right=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontStyle=1;" parent="just_t3_r3" vertex="1"><mxGeometry x="0" width="444" height="30" as="geometry"><mxRectangle width="444" height="30" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="just_t3_r3_c1" value="Somme de &lt;font face='Consolas' color='#1f4e79'&gt;montant_eur&lt;/font&gt; avec &lt;font face='Consolas' color='#1f4e79'&gt;statut = 'accepte'&lt;/font&gt; seulement (200 956 paiements) ; refusés (9 820) et en attente (6 524) exclus." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;" parent="just_t3_r3" vertex="1"><mxGeometry x="444" width="1036" height="30" as="geometry"><mxRectangle width="1036" heigh