color='#1f4e79'&gt;cout_eur&lt;/font&gt; ? »" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#f5f5f5;top=0;left=0;bottom=0;right=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontStyle=1;" parent="just_t3_r5" vertex="1"><mxGeometry x="0" width="444" height="30" as="geometry"><mxRectangle width="444" height="30" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="just_t3_r5_c1" value="NOT NULL ferait échouer l'import des 12 459 sessions annulées ; la CHECK exprime la vraie règle : NULL autorisé seulement si annulée." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;" parent="just_t3_r5" vertex="1"><mxGeometry x="444" width="1036" height="30" as="geometry"><mxRectangle width="1036" height="30" as="alternateBounds" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>