ve="1" as="geometry"/></mxCell><mxCell id="fk1" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;" edge="1" parent="1" source="sessions_recharge.id_vehicule" target="vehicules.id_vehicule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fk2" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;" edge="1" parent="1" source="sessions_recharge.id_borne" target="bornes.id_borne"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fk3" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;" edge="1" parent="1" source="paiements.id_session" target="sessions_recharge.id_session"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fk4" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;" edge="1" parent="1" source="bornes.id_station" target="stations.id_station"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fk5" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;" edge="1" parent="1" source="incidents.id_borne" target="bornes.id_borne"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fk6" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;" edge="1" parent="1" source="interventions.id_incident" target="incidents.id_incident"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fk7" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;" edge="1" parent="1" source="interventions.id_technicien" target="techniciens.id_technicien"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legende" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;PK clé primaire · FK clé étrangère · UQ unique · CK contrainte CHECK&lt;br&gt;Colonnes NOT NULL sauf mention NULL · Cardinalités : |— exactement 1, o&amp;lt; 0..N&lt;br&gt;&lt;br&gt;&lt;b&gt;CHECK&lt;/b&gt;&lt;br&gt;bornes.etat ∈ {disponible, maintenance, hors_service}&lt;br&gt;bornes.connecteur ∈ {CCS, Type2}&lt;br&gt;sessions_recharge.statut ∈ {terminee, interrompue, annulee}&lt;br&gt;&amp;nbsp;&amp;nbsp;→ si statut ≠ annulee : fin_session, energie_kwh, cout_eur NOT NULL&lt;br&gt;paiements.statut ∈ {accepte, refuse, en_attente}&lt;br&gt;paiements.mode_paiement ∈ {carte, application, abonnement}&lt;br&gt;incidents.statut ∈ {ouvert, resolu} ; gravite ∈ {faible, moyenne, haute}&lt;br&gt;&amp;nbsp;&amp;nbsp;→ date_resolution NULL ⇔ statut = ouvert&lt;br&gt;incidents.categorie ∈ {panne_connecteur, surchauffe, defaut_reseau, erreur_paiement}&lt;br&gt;interventions.statut ∈ {en_cours, terminee}&lt;br&gt;fin ≥ début pour sessions, incidents, interventions" style="text;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1060" height="290" as="geometry"/></mxCell><mxCell id="titre" value="UrbanWatt — Modèle logique de données (MLD)" style="text;html=1;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="600" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>